{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",  // ou "NodeNext" si tu utilises des imports/exports
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules"]
}